<!DOCTYPE html>
<html lang="de">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Werksturbo Register V4</title>

<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/home.css">

<!-- Tabulator -->
<link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator_midnight.min.css" rel="stylesheet">

</head>

<body>

<header>

    <div class="logo">
        <a href="index.html">
            <img src="images/logo-werksturbo.png" alt="Werksturbo Register">
        </a>
    </div>

    <nav>

        <ul>

            <li><a href="index.html">Startseite</a></li>

            <li><a class="active" href="register.html">Register</a></li>

            <li><a href="pages/pressefotos.html">Pressefotos</a></li>

            <li><a href="pages/dokumente.html">Dokumente</a></li>

            <li><a href="pages/presseberichte.html">Presseberichte</a></li>

            <li><a href="pages/wissensdatenbank.html">Wissensdatenbank</a></li>

            <li><a href="pages/kontakt.html">Kontakt</a></li>

        </ul>

    </nav>

</header>

<section class="toolbar">

    <input
        type="text"
        id="globalSearch"
        placeholder="🔍 Fahrzeuge durchsuchen...">

    <select id="countryFilter">
        <option value="">Land</option>
    </select>

    <select id="statusFilter">
        <option value="">Status</option>
    </select>

    <select id="yearFilter">
        <option value="">Baujahr</option>
    </select>

    <button id="resetFilters">
        🔄 Filter zurücksetzen
    </button>

    <!-- Trefferzähler -->
    <span id="resultCounter"></span>


</section>


<main>

    <!-- ==========================================================
         Suchleiste
    ========================================================== -->


    <div id="registerTable"></div>

</main>


    
    <!-- ==========================================================
         footer
    ========================================================== -->
  
    <footer>

        <div class="footer-content">

            <h3>Ford Capri III Werksturbo Register</h3>

            <div class="footer-nav">

            <a href="pages/impressum.html">Impressum</a>
            <a href="pages/datenschutz.html">Datenschutz</a>
            <a href="pages/kontakt.html">Kontakt</a>

            </div>

            <div class="footer-bottom">

                © 2026 Werksturbo Register

            </div>

        </div>

    </footer>

        

<!-- Bibliotheken -->

<script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>

<script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>

<script src="js/lightbox.js"></script>
<script src="js/script_v4.js"></script>

</body>

</html>
