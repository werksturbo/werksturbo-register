"use strict";

class WerksturboLightbox {

    constructor(options = {}) {

        this.version = "4.0.0";

        this.options = Object.assign({

            preload: true,
            keyboard: true,
            closeOnOverlay: true,
            loop: false,
            animationSpeed: 250

        }, options);

        /* ------------------------------
           Galerieverwaltung
        ------------------------------ */

        this.galleries = new Map();

        this.currentGallery = null;

        this.currentImages = [];

        this.currentIndex = 0;

        /* ------------------------------
           Status
        ------------------------------ */

        this.isOpen = false;

        this.isLoading = false;

        /* ------------------------------
           DOM Elemente
        ------------------------------ */

        this.dom = {

            lightbox: null,
            image: null,
            loader: null,

            close: null,
            previous: null,
            next: null,

            info: null,

            lnr: null,
            chassis: null,
            land: null,
            status: null,
            counter: null,

            download: null

        };

    }
